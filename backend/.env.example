# 複製成 .env（已在 .gitignore）。沒有 key 也能跑：Copilot 退回規則式分析、VLM 退回模擬感知。
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # Copilot 用
OPENAI_VISION_MODEL=gpt-4o-mini     # VLM 用（需支援影像）
# OPENAI_BASE_URL=                  # 相容端點（Azure / 本機 proxy）可填
TWIN_VLM_ACTS=0                     # 1 = VLM 偵測到人就真的封鎖 Zone（會干擾模擬，Demo 03 想全自動時開）
TWIN_SEED=42
